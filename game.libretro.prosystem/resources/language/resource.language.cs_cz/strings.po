msgctxt "Addon Summary"
msgid "Atari - 7800 (ProSystem)"
msgstr "Atari - 7800 (ProSystem)"

msgctxt "Addon Description"
msgid "ProSystem is an Atari 7800 emulator.[CR][CR]Place [I]7800 BIOS (U).rom[/I] (optional) in the emulator's userdata folder."
msgstr "ProSystem je emulátor Atari 7800.[CR][CR]Umístěte soubor [I]7800 BIOS (U).rom[/I] (volitelný) do složky userdata emulátoru."

msgctxt "#30001"
msgid "Color Depth (Restart)"
msgstr "Barevná hloubka (vyžaduje restart)"

msgctxt "#30002"
msgid "Audio Filter"
msgstr "Zvukový filtr"

msgctxt "#30003"
msgid "Audio Filter Level"
msgstr "Úroveň zvukového filtru"

msgctxt "#30004"
msgid "Dual Stick Controller"
msgstr "Ovladač se dvěma joysticky"

msgctxt "#30005"
msgid "Video"
msgstr "Video"

msgctxt "#30006"
msgid "Specifies number of colors to display on-screen. 24-bit may increase performance overheads on some platforms."
msgstr "Určuje počet barev zobrazených na obrazovce. 24bitová barevná hloubka může na některých platformách zvýšit režii výkonu."

msgctxt "#30007"
msgid "Thousands (16-bit)"
msgstr "Tisíce (16bitové)"

msgctxt "#30008"
msgid "Millions (24-bit)"
msgstr "Miliony (24bitové)"

msgctxt "#30009"
msgid "Audio"
msgstr "Zvuk"

msgctxt "#30010"
msgid "Enables a low pass audio filter to soften the 'harsh' sound produced by the Atari 7800's TIA chip."
msgstr "Povoluje dolní propustný zvukový filtr, který zjemňuje „ostrý“ zvuk vytvářený čipem TIA konzole Atari 7800."

msgctxt "#30011"
msgid "Specifies the cut-off frequency of the low pass audio filter. A higher value increases the perceived 'strength' of the filter, since a wider range of the high frequency spectrum is attenuated."
msgstr "Určuje mezní frekvenci dolnopropustného zvukového filtru. Vyšší hodnota zvyšuje vnímanou „sílu“ filtru, protože se utlumí širší rozsah vysokofrekvenčního spektra."

