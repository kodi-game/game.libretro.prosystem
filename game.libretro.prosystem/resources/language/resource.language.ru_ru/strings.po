msgctxt "Addon Summary"
msgid "Atari - 7800 (ProSystem)"
msgstr "Atari - 7800 (ProSystem)"

msgctxt "Addon Description"
msgid "ProSystem is an Atari 7800 emulator.[CR][CR]Place [I]7800 BIOS (U).rom[/I] (optional) in the emulator's userdata folder."
msgstr "ProSystem — эмулятор Atari 7800.[CR][CR]Поместите [I]7800 BIOS (U).rom[/I] (необязательно) в папку пользовательских данных эмулятора."

msgctxt "#30001"
msgid "Color Depth (Restart)"
msgstr "Глубина цвета (перезапуск)"

msgctxt "#30002"
msgid "Audio Filter"
msgstr "Фильтр звука"

msgctxt "#30003"
msgid "Audio Filter Level"
msgstr "Уровень аудиофильтра"

msgctxt "#30004"
msgid "Dual Stick Controller"
msgstr "Контроллер Dual Stick"

msgctxt "#30005"
msgid "Video"
msgstr "Видео"

msgctxt "#30006"
msgid "Specifies number of colors to display on-screen. 24-bit may increase performance overheads on some platforms."
msgstr "Указывает количество цветов для отображения на экране. 24 бита могут увеличить накладные расходы производительности на некоторых платформах."

msgctxt "#30007"
msgid "Thousands (16-bit)"
msgstr "Тысячи (16-бит)"

msgctxt "#30008"
msgid "Millions (24-bit)"
msgstr "Миллионы (24-бит)"

msgctxt "#30009"
msgid "Audio"
msgstr "Аудио"

msgctxt "#30010"
msgid "Enables a low pass audio filter to soften the 'harsh' sound produced by the Atari 7800's TIA chip."
msgstr "Включает фильтр нижних частот, чтобы смягчить «резкий» звук, производимый чипом TIA консоли Atari 7800."

msgctxt "#30011"
msgid "Specifies the cut-off frequency of the low pass audio filter. A higher value increases the perceived 'strength' of the filter, since a wider range of the high frequency spectrum is attenuated."
msgstr "Указывает частоту среза фильтра нижних частот. Более высокое значение увеличивает воспринимаемую «силу» фильтра, так как ослабляется более широкий диапазон высокочастотного спектра."

